{
  "extends": [
    "plugin:@mattermost/react"
  ],
  "env": {
    "jest": true
  },
  "globals": {
    "structuredClone": true
  },
  "rules": {
    "header/header": "off",
    "@typescript-eslint/no-unused-vars": [2, {"vars": "all", "args": "after-used", "argsIgnorePattern": "^_"}]
  },
  "overrides": [
    {
      "files": ["src/types/mattermost-webapp/index.d.ts"],
      "rules": {
        "@typescript-eslint/ban-types": "off"
      }
    }
  ]
}
